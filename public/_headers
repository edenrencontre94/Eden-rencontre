# En-têtes de cache — Cloudflare Pages / Workers
#
# ATTENTION : Nitro AJOUTE sa propre règle `/assets/*` à la fin de ce
# fichier au moment du build — il ne le remplace pas. La déclarer ici
# aussi produirait deux règles identiques sur le même chemin, donc un
# en-tête `cache-control` dupliqué que certains navigateurs refusent.
# Les fichiers hachés de `/assets/` sont donc volontairement absents.

# Icônes : le nom, lui, est fixe. `immutable` interdirait toute mise à
# jour pendant un an — un changement de logo resterait invisible. Une
# journée suffit : personne ne change de favicon deux fois par jour, et
# le navigateur cesse de le revalider à chaque page.
/favicon.ico
  cache-control: public, max-age=86400
/favicon-*.png
  cache-control: public, max-age=86400
/apple-touch-icon.png
  cache-control: public, max-age=86400
/icon-*.png
  cache-control: public, max-age=86400
/site.webmanifest
  cache-control: public, max-age=86400

# Service worker : JAMAIS en cache.
#
# Le navigateur ne remplace le service worker que si l'octet reçu diffère
# de celui qu'il détient. Servi depuis un cache, un correctif de
# notification pourrait rester invisible pendant des jours — sur un
# fichier qui, lui, décide de ce que les membres reçoivent.
/sw.js
  cache-control: no-cache, no-store, must-revalidate

# Les stickers sont immuables : leur contenu ne change jamais sans que
# leur nom change aussi. Un an de cache, et zéro requête ensuite.
/stickers/*
  cache-control: public, max-age=31536000, immutable

# Polices : même raisonnement. Une version différente porterait un autre
# nom de fichier. `immutable` évite au navigateur de les revalider à
# chaque visite — sur un réseau lent, cette revalidation coûte plus cher
# que le fichier lui-même.
/fonts/*
  cache-control: public, max-age=31536000, immutable

# Fichiers de référencement : une heure. Assez pour épargner des requêtes,
# assez court pour qu'une correction du sitemap soit prise en compte le
# jour même plutôt qu'à la prochaine visite de Google.
/robots.txt
  cache-control: public, max-age=3600
/sitemap.xml
  cache-control: public, max-age=3600
